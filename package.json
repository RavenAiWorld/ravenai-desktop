{
  "name": "ravenai-desktop",
  "productName": "Ravenai",
  "version": "1.0.0",
  "private": true,
  "description": "Ravenai desktop client for the production Sub2API service",
  "author": "Ravenai",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "check": "tsc --noEmit",
    "build": "tsc --noEmit && vite build && npm --prefix studio/frontend run studio:build",
    "start": "tauri dev",
    "package": "tauri build",
    "test": "vitest run",
    "tauri": "tauri"
  },
  "type": "module",
  "dependencies": {
    "@tanstack/react-query": "5.108.4",
    "@tauri-apps/api": "2.12.5",
    "lucide-react": "1.81.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tauri-apps/cli": "2.12.6",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.3.0",
    "typescript": "~5.9.3",
    "vite": "8.3.8",
    "vitest": "^4.0.0"
  }
}
